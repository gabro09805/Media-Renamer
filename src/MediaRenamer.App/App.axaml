<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediaRenamer.App.App"
             xmlns:local="using:MediaRenamer.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Scrollbars: always visible, reserving their own space (no overlay on the content) and wide enough for fingers. -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="22" />
            <Setter Property="MinWidth" Value="22" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <!-- Modern scrollbar: no arrow buttons, slim rounded thumb inside a wide (touch-friendly) hit area. -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Classes="sbpage" Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Classes="sbpage" Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb" Classes="sbthumb" />
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Classes="sbpage" Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Classes="sbpage" Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb" Classes="sbthumb" />
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RepeatButton.sbpage">
            <Setter Property="Template">
                <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.sbthumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Pill" CornerRadius="6" Background="#88808080" Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:vertical Thumb.sbthumb">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="ScrollBar:horizontal Thumb.sbthumb">
            <Setter Property="Padding" Value="2,6" />
            <Setter Property="MinWidth" Value="40" />
        </Style>
        <Style Selector="ScrollBar:pointerover Thumb.sbthumb /template/ Border#Pill">
            <Setter Property="Background" Value="#CC808080" />
        </Style>
        <Style Selector="Thumb.sbthumb:pressed /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button:not(.accent)">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="2,1" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #1A000000" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Application.Styles>
</Application>