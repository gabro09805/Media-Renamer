<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:MediaRenamer.App.Controls"
             xmlns:vm="using:MediaRenamer.App.ViewModels"
             x:Class="MediaRenamer.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Center">
            <TextBlock Text="Providers" FontSize="18" FontWeight="SemiBold" />

            <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderSettingsViewModel">
                        <Border BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <StackPanel Spacing="8">
                                <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding Title}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProviderFieldViewModel">
                                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding Value}"
                                                         PasswordChar="{Binding PasswordChar}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button ctl:Ic.Icon="save" Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
                                    <Button ctl:Ic.Icon="plug" Content="Test connection" Command="{Binding TestCommand}"
                                            IsEnabled="{Binding !IsBusy}" />
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding HasPluginProblems}" Spacing="4">
                <TextBlock Text="Plugins that could not be loaded" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding PluginProblems}" />
            </StackPanel>

            <TextBlock Text="Library" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="160,*,Auto">
                <TextBlock Text="Library folder" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding LibraryRoot}" PlaceholderText="Empty = rename in place" />
                <Button ctl:Ic.Icon="folder" Grid.Column="2" Margin="6,0,0,0" ToolTip.Tip="Choose library folder" Click="OnBrowseLibrary" />
            </Grid>

            <TextBlock Text="Cache" FontSize="18" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button ctl:Ic.Icon="trash" Content="Clear cache" Command="{Binding ClearCacheCommand}" />
                <TextBlock Text="{Binding CacheStatus}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
