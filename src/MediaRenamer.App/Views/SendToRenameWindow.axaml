<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:MediaRenamer.App.Controls"
        xmlns:vm="using:MediaRenamer.App.ViewModels"
        x:Class="MediaRenamer.App.Views.SendToRenameWindow"
        x:DataType="vm:SendToRenameViewModel"
        Title="Send to Rename" Width="820" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
        <Border BorderThickness="1" Padding="8" CornerRadius="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="How should files be associated with the selected episodes?" FontWeight="SemiBold" />
                <RadioButton GroupName="Assoc" Content="Mantieni ordine di Search Episodes (file names' numbering is ignored)"
                             IsChecked="{Binding IsSearchOrder}" />
                <RadioButton GroupName="Assoc" Content="Corrispondenza per numero episodio (season / episode found in the file names)"
                             IsChecked="{Binding IsEpisodeNumber}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{Binding Summary}" Opacity="0.8" />
            <TextBlock Text="{Binding Plan.Problem}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ListBox ItemsSource="{Binding Preview}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PairingRow">
                        <Grid ColumnDefinitions="360,Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{Binding File}" />
                            <TextBlock Grid.Column="1" Text="→" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Episode}" />
                                <TextBlock Text="{Binding Note}" FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button ctl:Ic.Icon="send" Classes="accent" Content="Send" MinWidth="90" HorizontalContentAlignment="Center" IsEnabled="{Binding CanSend}" Click="OnOk" />
            <Button ctl:Ic.Icon="close" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
