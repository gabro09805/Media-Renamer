<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:MediaRenamer.App.Controls"
        xmlns:vm="using:MediaRenamer.App.ViewModels"
        xmlns:host="using:MediaRenamer.PluginHost"
        x:Class="MediaRenamer.App.Views.SeriesPickerWindow"
        x:DataType="vm:BindingInspectorViewModel"
        Title="Search" Width="860" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
        <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="host:ProviderEntry"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="QueryBox" Grid.Column="1" Text="{Binding Query}" PlaceholderText="Name to search" KeyDown="OnQueryKeyDown" />
            <Button ctl:Ic.Icon="search" Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Opacity="0.8" TextWrapping="Wrap" />

        <Grid Grid.Row="2" ColumnDefinitions="*,240" ColumnSpacing="12">
            <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" DoubleTapped="OnResultDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultItem">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="4" Padding="8"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                    <TextBlock x:Name="PosterTitle" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <Grid>
                        <Image x:Name="Poster" Stretch="Uniform" />
                        <TextBlock x:Name="NoPoster" Text="No cover available" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Opacity="0.6" IsVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button ctl:Ic.Icon="check" Classes="accent" Content="Select" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="False" Click="OnSelect" />
            <Button ctl:Ic.Icon="close" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
